{
  "name": "beton-jarvis",
  "version": "0.1.0",
  "description": "A local-first JARVIS-style desktop voice assistant powered by Beton CLI and ElevenLabs.",
  "license": "MIT",
  "author": "Ayush Bhattacharya <info.cometlabs@gmail.com>",
  "homepage": "https://github.com/itsjustayush/beton-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjustayush/beton-cli.git",
    "directory": "jarvis-package"
  },
  "bugs": {
    "url": "https://github.com/itsjustayush/beton-cli/issues"
  },
  "keywords": ["jarvis", "friday", "desktop-assistant", "voice-assistant", "electron", "elevenlabs", "beton"],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "jarvis": "bin/jarvis.js"
  },
  "files": [
    "bin",
    "app",
    "main.js",
    "preload.js",
    "lib",
    "scripts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node bin/jarvis.js",
    "doctor": "node bin/jarvis.js doctor",
    "setup": "node bin/jarvis.js setup",
    "update": "node bin/jarvis.js update",
    "pack": "npm run build && npm pack",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.21.0",
    "electron": "^43.4.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
